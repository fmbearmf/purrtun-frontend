FROM node:24-slim

WORKDIR /app

# Install deps first for better layer caching
COPY package-lock.json package.json ./
RUN npm ci

# App source (dev image still bind-mounts in compose, but this supports plain `docker run`)
COPY . .

EXPOSE 3000

# Nuxt dev server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]

